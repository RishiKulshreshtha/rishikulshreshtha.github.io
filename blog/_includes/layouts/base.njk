<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = (title + " — Rishi Kulshreshtha") if title else site.title %}
  {%- set pageDescription = description or site.description %}
  {%- set pageCanonical = canonicalUrl or (site.url + page.url | replace(".html", "")) %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <link rel="canonical" href="{{ pageCanonical }}">
  <link rel="shortcut icon" href="/favicon.ico">
  <meta name="author" content="{{ site.author.name }}">
  {%- if draft %}
  <meta name="robots" content="noindex, nofollow">
  {%- endif %}

  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} (RSS)" href="{{ site.url }}/rss.xml">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }} (Atom)" href="{{ site.url }}/writing/feed.xml">
  <link rel="alternate" type="application/feed+json" title="{{ site.title }} (JSON Feed)" href="{{ site.url }}/writing/feed.json">

  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="{{ 'article' if isArticle else 'website' }}">
  <meta property="og:url" content="{{ pageCanonical }}">
  <meta property="og:image" content="{{ ogImage or site.defaultImage }}">
  <meta property="og:image:alt" content="{{ imageAlt or site.author.name }}">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@RishiShreshtha">
  <meta name="twitter:title" content="{{ pageTitle }}">
  <meta name="twitter:description" content="{{ pageDescription }}">
  <meta name="twitter:image" content="{{ ogImage or site.defaultImage }}">
  {%- if isArticle %}
  <meta property="article:published_time" content="{{ date | isoDate }}">
  <meta property="article:modified_time" content="{{ (updated or date) | isoDate }}">
  <meta property="article:author" content="{{ site.author.url }}">
  {%- for tag in tags %}{% if tag != "posts" %}
  <meta property="article:tag" content="{{ tag }}">
  {%- endif %}{% endfor %}
  <meta name="citation_title" content="{{ title }}">
  <meta name="citation_author" content="{{ site.author.name }}">
  <meta name="citation_publication_date" content="{{ date | isoDate | replace('-', '/') }}">
  <meta name="citation_public_url" content="{{ canonicalUrl }}">
  <script type="application/ld+json">
{{ ldData | jsonLd | safe }}
  </script>
  {%- endif %}

  {% if site.gtm %}<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','{{ site.gtm }}');</script>{% endif %}

  <script>
    (function () {
      try {
        var stored = localStorage.getItem('rk-theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored || (prefersDark ? 'dark' : 'light'));
      } catch (e) {}
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"></noscript>

  <link rel="stylesheet" href="/writing/assets/site.css">
  <link rel="stylesheet" href="/writing/assets/fa/css/all.min.css">
  <link rel="stylesheet" href="/writing/assets/blog.css">
</head>
<body>
  {% if site.gtm %}<noscript><iframe src="https://www.googletagmanager.com/ns.html?id={{ site.gtm }}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>{% endif %}
  <a class="skip-link" href="#main-content">Skip to main content</a>
  {% include "partials/nav.njk" %}
  <main id="main-content">
    {{ content | safe }}
  </main>
  {% include "partials/footer.njk" %}
  <script src="/writing/assets/blog.js" defer></script>
  {% if site.goatcounter %}<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>{% endif %}
</body>
</html>
