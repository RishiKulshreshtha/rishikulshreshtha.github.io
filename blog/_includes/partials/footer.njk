<footer class="footer">
  <div class="footer__inner container">
    <div class="footer__social">
      {%- for s in site.socials %}
      <a class="footer__link" href="{{ s.href }}" target="_blank" rel="noopener" aria-label="{{ s.label }}"><i class="{{ s.icon }}" aria-hidden="true"></i></a>
      {%- endfor %}
    </div>
    <nav class="footer__meta" aria-label="Footer">
      <a class="footer__meta-link" href="/playground">// PLAYGROUND</a>
      <a class="footer__meta-link" href="/accessibility-statement">// ACCESSIBILITY STATEMENT</a>
    </nav>
    <p class="footer__copy">&copy; 2011&ndash;{{ site.year }} Rishi Kulshreshtha</p>
  </div>
</footer>
