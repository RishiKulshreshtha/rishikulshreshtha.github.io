---
permalink: /writing/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/writing/feed.xml" rel="self"/>
  <link href="{{ site.url }}/writing"/>
  <updated>{{ collections.posts | getNewestCollectionItemDate | dateRfc3339 }}</updated>
  <id>{{ site.url }}/writing</id>
  <author>
    <name>{{ site.author.name }}</name>
    <uri>{{ site.author.url }}</uri>
  </author>
  {%- for post in collections.posts | reverse %}
  {%- set url = site.url + "/writing/" + post.fileSlug %}
  <entry>
    <title>{{ post.data.title | escape }}</title>
    <link href="{{ url }}"/>
    <published>{{ post.date | dateRfc3339 }}</published>
    <updated>{{ (post.data.updated or post.date) | dateRfc3339 }}</updated>
    <id>{{ url }}</id>
    <summary>{{ post.data.description | escape }}</summary>
    <content type="html">{{ post.templateContent | htmlToAbsoluteUrls(site.url) | escape }}</content>
  </entry>
  {%- endfor %}
</feed>
