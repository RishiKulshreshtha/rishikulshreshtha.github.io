---
permalink: /writing/feed.json
eleventyExcludeFromCollections: true
---
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ site.title | dump | safe }},
  "home_page_url": "{{ site.url }}/writing",
  "feed_url": "{{ site.url }}/writing/feed.json",
  "description": {{ site.description | dump | safe }},
  "language": "en",
  "authors": [{ "name": {{ site.author.name | dump | safe }}, "url": "{{ site.author.url }}" }],
  "items": [
    {%- for post in collections.posts | reverse %}
    {%- set url = site.url + "/writing/" + post.fileSlug %}
    {
      "id": "{{ url }}",
      "url": "{{ url }}",
      "title": {{ post.data.title | dump | safe }},
      "summary": {{ post.data.description | dump | safe }},
      "content_html": {{ post.templateContent | htmlToAbsoluteUrls(site.url) | dump | safe }},
      "date_published": "{{ post.date | dateRfc3339 }}",
      "date_modified": "{{ (post.data.updated or post.date) | dateRfc3339 }}",
      "tags": {{ post.data.tags | reject("equalto", "posts") | list | dump | safe }}
    }{{ "," if not loop.last }}
    {%- endfor %}
  ]
}
