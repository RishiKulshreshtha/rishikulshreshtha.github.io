---
layout: layouts/base.njk
permalink: /writing.html
title: Writing
description: Notes on Drupal, web accessibility, and AI-readiness from Rishi Kulshreshtha.
eleventyComputed:
  canonicalUrl: "{{ site.url }}/writing"
---
{% set posts = collections.posts | reverse %}
<section class="blog section" aria-label="Writing">
  <div class="container">
    <div class="section__header">
      <span class="section__label">// WRITING</span>
      <h1 class="section__title">WRITING</h1>
    </div>

    {%- if posts.length == 0 %}
    <div class="blog__empty">
      <p class="blog__coming-soon">COMING SOON</p>
      <p class="blog__sub">Notes on Drupal, accessibility, and AI-readiness, in progress.</p>
    </div>
    {%- else %}
    <ul class="blog__list" role="list">
      {%- for post in posts %}
      <li class="blog__card">
        <a class="blog__link" href="/writing/{{ post.fileSlug }}">
          <time class="blog__date" datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
          <h2 class="blog__title">{{ post.data.title }}</h2>
          <p class="blog__desc">{{ post.data.description }}</p>
        </a>
        {%- set postTags = post.data.tags | reject("equalto", "posts") | list %}
        {%- if postTags.length %}
        <ul class="tags blog__tags" role="list" aria-label="Tags">
          {%- for tag in postTags %}
          <li><a class="tag" href="/writing/tags/{{ tag | slugifyTag }}">{{ tag }}</a></li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}

    <p class="blog__feeds">
      Subscribe: <a href="/rss.xml">RSS</a> · <a href="/writing/feed.xml">Atom</a> · <a href="/writing/feed.json">JSON Feed</a>
    </p>
  </div>
</section>
