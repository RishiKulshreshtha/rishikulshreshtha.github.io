---
permalink: /writing/sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/writing</loc>
    <lastmod>{{ collections.posts | getNewestCollectionItemDate | isoDate }}</lastmod>
  </url>
  {%- for post in collections.posts | reverse %}
  <url>
    <loc>{{ site.url }}/writing/{{ post.fileSlug }}</loc>
    <lastmod>{{ (post.data.updated or post.date) | isoDate }}</lastmod>
  </url>
  {%- endfor %}
  {%- for tag in collections.tagList %}
  <url>
    <loc>{{ site.url }}/writing/tags/{{ tag | slugifyTag }}</loc>
  </url>
  {%- endfor %}
</urlset>
